# ============================================================
# CloudDash Multi-Agent Customer Support System
# Environment Variables Reference
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ============================================================
# LLM Configuration (Groq)
# ============================================================
# REQUIRED: Your Groq API key for the agents and query rewriter
GROQ_API_KEY="gsk_your_groq_key_here"

# OPTIONAL: The Groq model to use (defaults to llama-3.3-70b-versatile)
GROQ_MODEL="llama-3.3-70b-versatile"

# ---- Vector Store ----------------------------------------
# Path where ChromaDB will persist its data.
# OPTIONAL — Default: ./chroma_db
CHROMA_DB_PATH=./chroma_db

# ChromaDB collection name for the knowledge base
# OPTIONAL — Default: clouddash_kb
CHROMA_COLLECTION_NAME=clouddash_kb

# ---- Retrieval -------------------------------------------
# Number of chunks to retrieve per query
# OPTIONAL — Default: 5
TOP_K_RETRIEVAL=5

# Minimum cosine similarity score to include a chunk
# OPTIONAL — Default: 0.35
MIN_SIMILARITY_SCORE=0.35

# Number of recent messages to pass to query rewriter
# OPTIONAL — Default: 5
QUERY_REWRITER_WINDOW=5

# ---- Logging ---------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
# OPTIONAL — Default: INFO
LOG_LEVEL=INFO

# Path for rotating file log
# OPTIONAL — Default: logs/app.log
LOG_FILE=logs/app.log

# ---- API Server ------------------------------------------
# Host and port for FastAPI server
# OPTIONAL — Defaults: 0.0.0.0 / 8000
API_HOST=0.0.0.0
API_PORT=8000

# Request timeout in seconds (handled at uvicorn level)
# OPTIONAL — Default: 60
REQUEST_TIMEOUT=60

# ---- Rate Limiting ---------------------------------------
# Maximum requests per minute per IP address
# OPTIONAL — Default: 30
RATE_LIMIT_RPM=30

# ---- Session / Memory ------------------------------------
# TTL for in-memory conversation sessions (seconds)
# OPTIONAL — Default: 3600 (1 hour)
SESSION_TTL_SECONDS=3600

# ---- Streamlit UI ----------------------------------------
# Base URL the Streamlit app uses to reach the FastAPI backend
# OPTIONAL — Default: http://localhost:8000
STREAMLIT_API_URL=http://localhost:8000

# ---- Environment -----------------------------------------
# Set to "development" or "production"
# OPTIONAL — Default: development
ENVIRONMENT=development
